{
  "name": "ecommerce-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm run dev -w @acme/web",
    "dev:api": "npm run dev -w @acme/api",
    "build": "npm run build -ws",
    "lint": "npm run lint -ws",
    "typecheck": "npm run typecheck -ws",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "npm-run-all": "^4.1.5",
    "prisma": "^5.10.2",
    "typescript": "^5.4.2"
  }
}
